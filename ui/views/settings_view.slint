import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/text_field.slint";
import { SegmentedChoice } from "../components/segmented_choice.slint";
import { ToggleOption } from "../components/toggle_option.slint";
import { SystemOption } from "../common.slint";
import { Theme } from "../theme.slint";

export component SettingsView inherits Rectangle {
    in-out property <string> selected-system-id;
    in property <[SystemOption]> available-systems;
    in-out property <string> rom-set-path;
    in-out property <string> dat-file-path;
    in-out property <string> catver-ini-path;
    in-out property <string> languages-ini-path;
    in-out property <string> backup-dir-path;
    in-out property <bool> use-recycle-bin: true;
    in-out property <bool> language-is-english;
    in property <string> settings-status-text;
    callback browse-rom-set-path();
    callback browse-dat-file-path();
    callback browse-catver-ini-path();
    callback browse-languages-ini-path();
    callback browse-backup-dir-path();
    callback save-settings();

    Flickable {
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: start;

            Text {
                text: "Paramètres";
                font-size: 20px;
                font-weight: 700;
            }

            Text { text: "Système actif"; font-weight: 600; }
            VerticalLayout {
                spacing: 6px;
                for system[i] in root.available-systems: VerticalLayout {
                    if system.is-header: Text {
                        text: system.console-family;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.color-accent;
                    }
                    if !system.is-header: AppButton {
                        width: 260px;
                        height: 30px;
                        text: system.name;
                        primary: system.id == root.selected-system-id;
                        clicked => { root.selected-system-id = system.id; }
                    }
                }
            }

            Text { text: "Dossier du set de ROMs"; }
            HorizontalLayout {
                spacing: 8px;
                TextField { value <=> root.rom-set-path; placeholder: "Chemin du dossier de ROMs"; }
                AppButton { width: 120px; text: "Parcourir"; clicked => { root.browse-rom-set-path(); } }
            }

            Text { text: "Fichier DAT de référence (MAME ou système sélectionné)"; }
            HorizontalLayout {
                spacing: 8px;
                TextField { value <=> root.dat-file-path; placeholder: "Chemin du fichier DAT"; }
                AppButton { width: 120px; text: "Parcourir"; clicked => { root.browse-dat-file-path(); } }
            }

            Text { text: "Fichier catver.ini"; }
            HorizontalLayout {
                spacing: 8px;
                TextField { value <=> root.catver-ini-path; placeholder: "Chemin de catver.ini"; }
                AppButton { width: 120px; text: "Parcourir"; clicked => { root.browse-catver-ini-path(); } }
            }

            Text { text: "Fichier languages.ini"; }
            HorizontalLayout {
                spacing: 8px;
                TextField { value <=> root.languages-ini-path; placeholder: "Chemin de languages.ini"; }
                AppButton { width: 120px; text: "Parcourir"; clicked => { root.browse-languages-ini-path(); } }
            }

            Text { text: "Dossier de sauvegarde avant nettoyage (optionnel)"; }
            HorizontalLayout {
                spacing: 8px;
                TextField { value <=> root.backup-dir-path; placeholder: "Aucune sauvegarde si vide"; }
                AppButton { width: 120px; text: "Parcourir"; clicked => { root.browse-backup-dir-path(); } }
            }

            ToggleOption {
                text: "Déplacer vers la corbeille Windows plutôt que supprimer définitivement";
                checked <=> root.use-recycle-bin;
            }

            Text { text: "Langue de l'interface"; font-weight: 600; }
            SegmentedChoice {
                width: 200px;
                option-a: "Français";
                option-b: "English";
                selected-b <=> root.language-is-english;
            }

            AppButton {
                width: 200px;
                text: "Enregistrer";
                primary: true;
                clicked => { root.save-settings(); }
            }

            Text { text: root.settings-status-text; }
        }
    }
}
