import { Theme } from "../theme.slint";
import { SectionCard } from "../components/section_card.slint";

component LinkText inherits Rectangle {
    in property <string> text;
    callback activated();

    width: label.preferred-width;
    height: label.preferred-height;

    label := Text {
        text: root.text;
        color: touch.has-hover ? Theme.color-accent-hover : Theme.color-accent;
        font-size: Theme.font-size-body;
    }

    Rectangle {
        y: label.height - 1px;
        height: 1px;
        width: label.width;
        background: touch.has-hover ? Theme.color-accent-hover : Theme.color-accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component AboutView inherits Rectangle {
    opacity: 0;
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
    init => { self.opacity = 1; }

    in property <string> title: "À propos";
    in property <string> app-version: "0.1.0";
    in property <string> copyright-text: "Copyright © 2026 Patrick JAILLET — Tous droits réservés";
    in property <string> contact-email: "sandefjord.development@proton.me";
    in property <string> website-url: "https://patrickjaillet.github.io/MAMESET-Cleaner";
    in property <string> releases-url: "https://github.com/Patrickjaillet/MAMESET-Cleaner/releases";
    in property <string> license-name: "MIT";
    callback open-url(string);

    Flickable {
        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;
            alignment: start;

            Text {
                text: root.title;
                font-size: Theme.font-size-title;
                font-weight: 700;
            }

            SectionCard {
                HorizontalLayout {
                    spacing: Theme.space-lg;
                    alignment: start;

                    Image {
                        source: @image-url("../../assets/icons/app.png");
                        width: 64px;
                        height: 64px;
                    }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        alignment: center;

                        Text {
                            text: "MAMESET Cleaner";
                            font-size: Theme.font-size-heading;
                            font-weight: 700;
                        }
                        Text {
                            text: "Version " + root.app-version;
                            color: Theme.color-text-secondary;
                        }
                        Text {
                            text: root.copyright-text;
                            color: Theme.color-text-secondary;
                            font-size: Theme.font-size-caption;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            SectionCard {
                Text { text: "Liens"; font-weight: 600; font-size: Theme.font-size-heading; }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Text { text: "Site du projet :"; color: Theme.color-text-secondary; }
                    LinkText { text: root.website-url; activated => { root.open-url(root.website-url); } }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Text { text: "Nouvelles versions :"; color: Theme.color-text-secondary; }
                    LinkText { text: "Voir les releases sur GitHub"; activated => { root.open-url(root.releases-url); } }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Text { text: "Contact :"; color: Theme.color-text-secondary; }
                    LinkText { text: root.contact-email; activated => { root.open-url("mailto:" + root.contact-email); } }
                }
            }

            SectionCard {
                Text { text: "Licence"; font-weight: 600; font-size: Theme.font-size-heading; }
                Text { text: "MAMESET Cleaner est distribué sous licence " + root.license-name + "."; wrap: word-wrap; }
            }

            SectionCard {
                Text { text: "Remerciements"; font-weight: 600; font-size: Theme.font-size-heading; }
                Text {
                    text: "Réalisé avec Rust et Slint. La reconnaissance des ROMs s'appuie sur le travail de catalogage des projets No-Intro, TOSEC, Redump et MAME — ce logiciel n'existerait pas sans leur travail.";
                    color: Theme.color-text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }
}
