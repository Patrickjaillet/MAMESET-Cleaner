import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/text_field.slint";
import { PluginRow } from "../common.slint";
import { Theme } from "../theme.slint";

export component PluginsView inherits Rectangle {
    opacity: 0;
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
    init => { self.opacity = 1; }

    in property <bool> plugins-loading;
    in property <string> plugins-status-text;
    in property <[PluginRow]> plugin-rows;
    in property <bool> plugin-install-active;
    in property <float> plugin-install-progress;
    in property <string> plugin-install-status-text;
    in-out property <string> plugins-search-text;
    callback refresh-plugins();
    callback search-plugins();
    callback install-plugin(string);
    callback remove-plugin(string);

    Flickable {
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: start;

            Text {
                text: "Plugins";
                font-size: 20px;
                font-weight: 700;
            }

            Text {
                text: "Ajoutez la prise en charge d'autres consoles en installant des plugins depuis le dépôt GitHub du projet.";
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                AppButton {
                    width: 240px;
                    text: plugins-loading ? "Actualisation..." : "Actualiser depuis GitHub";
                    primary: true;
                    enabled: !plugins-loading;
                    clicked => { root.refresh-plugins(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                TextField {
                    placeholder: "Rechercher un système ou une famille...";
                    value <=> root.plugins-search-text;
                }
                AppButton {
                    width: 120px;
                    text: "Rechercher";
                    clicked => { root.search-plugins(); }
                }
            }

            Text {
                text: plugins-status-text;
                wrap: word-wrap;
            }

            if plugin-install-active: VerticalLayout {
                spacing: 6px;

                Rectangle {
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.color-border-subtle;
                    clip: true;

                    Rectangle {
                        width: parent.width * (plugin-install-progress < 0.0 ? 0.0 : (plugin-install-progress > 1.0 ? 1.0 : plugin-install-progress));
                        height: parent.height;
                        background: Theme.color-accent;
                        animate width { duration: Theme.duration-medium; easing: ease-out; }
                    }
                }

                Text { text: plugin-install-status-text; }
            }

            for row[i] in plugin-rows: VerticalLayout {
                if row.is-header: Text {
                    text: row.console-family;
                    font-size: Theme.font-size-heading;
                    font-weight: 700;
                    color: Theme.color-accent;
                }

                if !row.is-header: Rectangle {
                    height: 64px;
                    background: Theme.color-surface;
                    border-width: 1px;
                    border-color: Theme.color-border-subtle;
                    border-radius: Theme.radius-md;
                    drop-shadow-color: card-touch.has-hover ? Theme.shadow-color-strong : Theme.shadow-color;
                    drop-shadow-blur: card-touch.has-hover ? 10px : 4px;
                    drop-shadow-offset-y: card-touch.has-hover ? 3px : 1px;
                    animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.duration-fast; easing: ease-out; }

                    card-touch := TouchArea {
                        // Purely for hover elevation; no click behavior of its own.
                    }

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;

                            Text { text: row.name; font-weight: 600; }
                            Text {
                                text: row.console-family + " — v" + row.version + " — " + row.status-text;
                                font-size: 12px;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            AppButton {
                                width: 130px;
                                text: row.status-kind == 2 ? "Mettre à jour" : "Installer";
                                visible: row.status-kind != 1;
                                enabled: !plugin-install-active;
                                primary: true;
                                clicked => { root.install-plugin(row.id); }
                            }
                            AppButton {
                                width: 110px;
                                text: "Supprimer";
                                visible: row.status-kind != 0;
                                enabled: !plugin-install-active;
                                clicked => { root.remove-plugin(row.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
