import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/text_field.slint";
import { ToggleOption } from "../components/toggle_option.slint";
import { MultiSelectPicker, FilterOption } from "../components/multi_select_picker.slint";
import { Theme } from "../theme.slint";

export component FilterView inherits Rectangle {
    opacity: 0;
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
    init => { self.opacity = 1; }

    in property <[FilterOption]> category-options;
    in property <[FilterOption]> language-options;
    in property <[FilterOption]> region-options;
    in property <[FilterOption]> manufacturer-options;
    in property <int> category-selected-count;
    in property <int> language-selected-count;
    in property <int> region-selected-count;
    in property <int> manufacturer-selected-count;
    callback toggle-category(string);
    callback toggle-language(string);
    callback toggle-region(string);
    callback toggle-manufacturer(string);
    in-out property <string> filter-year-min-text;
    in-out property <string> filter-year-max-text;
    in-out property <bool> filter-status-good;
    in-out property <bool> filter-status-imperfect;
    in-out property <bool> filter-status-preliminary;
    in-out property <bool> filter-status-unknown;
    in-out property <bool> filter-include-bios;
    in-out property <bool> filter-include-device;
    in-out property <bool> filter-include-mechanical;
    in-out property <bool> filter-include-adult;
    in property <string> filter-summary-text;
    callback apply-filters();

    Flickable {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            Text {
                text: "Filtres";
                font-size: 20px;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 12px;

                MultiSelectPicker {
                    horizontal-stretch: 1;
                    label: "Genres";
                    options: root.category-options;
                    selected-count: root.category-selected-count;
                    toggle(value) => { root.toggle-category(value); }
                }

                MultiSelectPicker {
                    horizontal-stretch: 1;
                    label: "Langues";
                    options: root.language-options;
                    selected-count: root.language-selected-count;
                    toggle(value) => { root.toggle-language(value); }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                MultiSelectPicker {
                    horizontal-stretch: 1;
                    label: "Régions";
                    options: root.region-options;
                    selected-count: root.region-selected-count;
                    toggle(value) => { root.toggle-region(value); }
                }

                MultiSelectPicker {
                    horizontal-stretch: 1;
                    label: "Fabricants";
                    options: root.manufacturer-options;
                    selected-count: root.manufacturer-selected-count;
                    toggle(value) => { root.toggle-manufacturer(value); }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Année minimum"; }
                    TextField { placeholder: "ex: 1980"; value <=> root.filter-year-min-text; }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Année maximum"; }
                    TextField { placeholder: "ex: 1999"; value <=> root.filter-year-max-text; }
                }
            }

            Text { text: "Statut de fonctionnement"; font-weight: 600; }
            HorizontalLayout {
                spacing: 16px;
                ToggleOption { text: "Bon"; checked <=> root.filter-status-good; }
                ToggleOption { text: "Imparfait"; checked <=> root.filter-status-imperfect; }
                ToggleOption { text: "Préliminaire"; checked <=> root.filter-status-preliminary; }
                ToggleOption { text: "Non fonctionnel"; checked <=> root.filter-status-unknown; }
            }

            Text { text: "Types de contenu"; font-weight: 600; }
            HorizontalLayout {
                spacing: 16px;
                ToggleOption { text: "BIOS"; checked <=> root.filter-include-bios; }
                ToggleOption { text: "Devices"; checked <=> root.filter-include-device; }
                ToggleOption { text: "Mécaniques"; checked <=> root.filter-include-mechanical; }
                ToggleOption { text: "Adulte"; checked <=> root.filter-include-adult; }
            }

            AppButton {
                width: 200px;
                text: "Appliquer les filtres";
                primary: true;
                clicked => { root.apply-filters(); }
            }

            Text { text: root.filter-summary-text; }
        }
    }
}
