import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/text_field.slint";
import { EmptyState } from "../components/empty_state.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { ResultRow } from "../common.slint";
import { Theme } from "../theme.slint";

export component ResultsView inherits Rectangle {
    opacity: 0;
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
    init => { self.opacity = 1; }

    in-out property <string> search-text;
    in property <[ResultRow]> result-rows;
    in property <string> result-count-text;
    in property <string> current-sort-column: "name";
    in property <bool> sort-ascending: true;
    in property <bool> cleanup-confirm-visible;
    in property <string> cleanup-target-count-text;
    in property <string> cleanup-status-text;
    in property <string> integrity-status-text;
    callback search-triggered();
    callback sort-by(string);
    callback request-cleanup();
    callback confirm-cleanup();
    callback cancel-cleanup();

    property <bool> has-content: root.result-count-text != "" || root.result-rows.length > 0;

    function sort-arrow(column: string) -> string {
        return root.current-sort-column != column ? "" : (root.sort-ascending ? " ▲" : " ▼");
    }

    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: start;

        Text {
            text: "Résultats";
            font-size: 20px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 8px;
            TextField {
                placeholder: "Rechercher un jeu...";
                value <=> root.search-text;
            }
            AppButton {
                width: 120px;
                text: "Rechercher";
                clicked => { root.search-triggered(); }
            }
            AppButton {
                width: 200px;
                text: "Nettoyer les doublons";
                clicked => { root.request-cleanup(); }
            }
        }

        Text { text: root.result-count-text; }
        Text { text: root.cleanup-status-text; wrap: word-wrap; }
        Text { text: root.integrity-status-text; wrap: word-wrap; }

        if !root.has-content: EmptyState {
            vertical-stretch: 1;
            icon: "📋";
            title-text: "Aucun résultat pour l'instant";
            subtitle-text: "Lancez d'abord un scan depuis l'onglet Scan pour voir apparaître les ROMs ici.";
        }

        if root.has-content: Rectangle {
            border-width: 1px;
            border-color: Theme.color-border-subtle;
            background: Theme.color-surface-alt;
            height: Theme.row-height-dense;

            HorizontalLayout {
                padding-left: Theme.space-xs;
                padding-right: Theme.space-xs;
                spacing: Theme.space-xs;

                Text { horizontal-stretch: 8; min-width: 55px; text: "Statut"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                TouchArea {
                    horizontal-stretch: 20;
                    min-width: 60px;
                    clicked => { root.sort-by("name"); }
                    Text { text: "Nom" + root.sort-arrow("name"); font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                }
                TouchArea {
                    horizontal-stretch: 6;
                    min-width: 40px;
                    clicked => { root.sort-by("year"); }
                    Text { text: "Année" + root.sort-arrow("year"); font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                }
                Text { horizontal-stretch: 14; min-width: 60px; text: "Fabricant"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                Text { horizontal-stretch: 12; min-width: 55px; text: "Genre"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                Text { horizontal-stretch: 8; min-width: 65px; text: "CRC32"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                Text { horizontal-stretch: 7; min-width: 55px; text: "Taille"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
                Text { horizontal-stretch: 10; min-width: 65px; text: "Action"; font-weight: 600; font-size: Theme.font-size-caption; vertical-alignment: center; }
            }
        }

        if root.has-content: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                for row in root.result-rows: Rectangle {
                    height: Theme.row-height-dense;
                    border-width: 1px;
                    border-color: Theme.color-border-subtle;
                    background: row-touch.has-hover ? Theme.color-accent : Theme.color-surface;

                    row-touch := TouchArea {}

                    HorizontalLayout {
                        padding-left: Theme.space-xs;
                        padding-right: Theme.space-xs;
                        spacing: Theme.space-xs;

                        StatusBadge {
                            horizontal-stretch: 8;
                            min-width: 55px;
                            kind: row.status-kind;
                        }
                        Text {
                            horizontal-stretch: 20;
                            min-width: 60px;
                            text: row.name;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 6;
                            min-width: 40px;
                            text: row.year;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 14;
                            min-width: 60px;
                            text: row.manufacturer;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 12;
                            min-width: 55px;
                            text: row.category;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 8;
                            min-width: 65px;
                            text: row.crc;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 7;
                            min-width: 55px;
                            text: row.size;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 10;
                            min-width: 65px;
                            text: row.action;
                            font-size: Theme.font-size-caption;
                            color: row-touch.has-hover ? Theme.color-text-on-accent : Theme.color-text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.cleanup-confirm-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.scrim-color;
        opacity: 0;
        animate opacity { duration: Theme.duration-fast; easing: ease-out; }
        init => { self.opacity = 1; }

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 220px;
            background: Theme.color-surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.color-border;
            drop-shadow-color: Theme.shadow-color-strong;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Confirmer le nettoyage";
                    font-size: 16px;
                    font-weight: 700;
                }

                Text {
                    text: root.cleanup-target-count-text;
                    wrap: word-wrap;
                }

                Text {
                    text: "Cette action déplacera (ou supprimera) les fichiers concernés. Voulez-vous continuer ?";
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    AppButton {
                        text: "Annuler";
                        clicked => { root.cancel-cleanup(); }
                    }
                    AppButton {
                        text: "Confirmer";
                        primary: true;
                        clicked => { root.confirm-cleanup(); }
                    }
                }
            }
        }
    }
}
