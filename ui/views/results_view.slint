import { AppButton } from "../components/app_button.slint";
import { TextField } from "../components/text_field.slint";
import { ResultRow } from "../common.slint";
import { Theme } from "../theme.slint";

export component ResultsView inherits Rectangle {
    opacity: 0;
    animate opacity { duration: Theme.duration-medium; easing: ease-out; }
    init => { self.opacity = 1; }

    in-out property <string> search-text;
    in property <[ResultRow]> result-rows;
    in property <string> result-count-text;
    in property <bool> cleanup-confirm-visible;
    in property <string> cleanup-target-count-text;
    in property <string> cleanup-status-text;
    in property <string> integrity-status-text;
    callback search-triggered();
    callback sort-by(string);
    callback request-cleanup();
    callback confirm-cleanup();
    callback cancel-cleanup();

    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: start;

        Text {
            text: "Résultats";
            font-size: 20px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 8px;
            TextField {
                placeholder: "Rechercher un jeu...";
                value <=> root.search-text;
            }
            AppButton {
                width: 120px;
                text: "Rechercher";
                clicked => { root.search-triggered(); }
            }
            AppButton {
                width: 200px;
                text: "Nettoyer les doublons";
                clicked => { root.request-cleanup(); }
            }
        }

        Text { text: root.result-count-text; }
        Text { text: root.cleanup-status-text; wrap: word-wrap; }
        Text { text: root.integrity-status-text; wrap: word-wrap; }

        Rectangle {
            border-width: 1px;
            border-color: #d8d8d8;
            background: #f6f6f6;
            height: 32px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                TouchArea {
                    width: 220px;
                    clicked => { root.sort-by("name"); }
                    Text { text: "Nom"; font-weight: 600; vertical-alignment: center; }
                }
                TouchArea {
                    width: 80px;
                    clicked => { root.sort-by("year"); }
                    Text { text: "Année"; font-weight: 600; vertical-alignment: center; }
                }
                Text { width: 160px; text: "Fabricant"; font-weight: 600; vertical-alignment: center; }
                Text { width: 140px; text: "Genre"; font-weight: 600; vertical-alignment: center; }
                Text { width: 120px; text: "Statut"; font-weight: 600; vertical-alignment: center; }
                Text { width: 130px; text: "Action"; font-weight: 600; vertical-alignment: center; }
            }
        }

        Flickable {
            VerticalLayout {
                for row in root.result-rows: Rectangle {
                    height: 30px;
                    border-width: 1px;
                    border-color: Theme.color-border-subtle;
                    background: row-touch.has-hover ? Theme.color-hover-tint : transparent;
                    animate background { duration: Theme.duration-fast; easing: ease-out; }

                    row-touch := TouchArea {
                        // Hover highlight only; a full drop-shadow per row was
                        // considered but skipped for performance reasons on
                        // sets with thousands of rows (see ROADMAP4 v3.2.0 notes).
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text { width: 220px; text: row.name; vertical-alignment: center; overflow: elide; }
                        Text { width: 80px; text: row.year; vertical-alignment: center; }
                        Text { width: 160px; text: row.manufacturer; vertical-alignment: center; overflow: elide; }
                        Text { width: 140px; text: row.category; vertical-alignment: center; overflow: elide; }
                        Text { width: 120px; text: row.status; vertical-alignment: center; }
                        Text { width: 130px; text: row.action; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    if root.cleanup-confirm-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45);
        opacity: 0;
        animate opacity { duration: Theme.duration-fast; easing: ease-out; }
        init => { self.opacity = 1; }

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 220px;
            background: Theme.color-surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.color-border;
            drop-shadow-color: Theme.shadow-color-strong;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Confirmer le nettoyage";
                    font-size: 16px;
                    font-weight: 700;
                }

                Text {
                    text: root.cleanup-target-count-text;
                    wrap: word-wrap;
                }

                Text {
                    text: "Cette action déplacera (ou supprimera) les fichiers concernés. Voulez-vous continuer ?";
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    AppButton {
                        text: "Annuler";
                        clicked => { root.cancel-cleanup(); }
                    }
                    AppButton {
                        text: "Confirmer";
                        primary: true;
                        clicked => { root.confirm-cleanup(); }
                    }
                }
            }
        }
    }
}
