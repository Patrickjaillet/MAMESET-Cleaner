import { Theme } from "../theme.slint";

export component SegmentedChoice inherits Rectangle {
    in property <string> option-a;
    in property <string> option-b;
    in-out property <bool> selected-b;

    height: 34px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.color-border;
    clip: true;

    HorizontalLayout {
        Rectangle {
            background: !root.selected-b ? Theme.color-accent : Theme.color-bg;

            TouchArea {
                clicked => { root.selected-b = false; }
            }

            Text {
                text: root.option-a;
                font-size: Theme.font-size-body;
                color: !root.selected-b ? Theme.color-text-on-accent : Theme.color-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            background: root.selected-b ? Theme.color-accent : Theme.color-bg;

            TouchArea {
                clicked => { root.selected-b = true; }
            }

            Text {
                text: root.option-b;
                font-size: Theme.font-size-body;
                color: root.selected-b ? Theme.color-text-on-accent : Theme.color-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
