import { Theme } from "../theme.slint";

export component ToggleOption inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;

    height: 26px;

    HorizontalLayout {
        spacing: Theme.space-sm;
        alignment: start;

        box := Rectangle {
            width: 18px;
            height: 18px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: root.checked ? Theme.color-accent : Theme.color-border-strong;
            background: root.checked ? Theme.color-accent : Theme.color-surface;
            animate border-color, background { duration: Theme.duration-fast; easing: ease-out; }

            check-mark := Text {
                text: "✓";
                color: Theme.color-text-on-accent;
                opacity: root.checked ? 1 : 0;
                animate opacity { duration: Theme.duration-fast; easing: ease-out; }
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.checked = !root.checked; }
            }
        }

        Text {
            text: root.text;
            font-size: Theme.font-size-body;
            color: Theme.color-text;
            vertical-alignment: center;
        }
    }
}
