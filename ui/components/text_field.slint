import { Theme } from "../theme.slint";

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;

    height: 34px;
    background: Theme.color-surface;
    border-width: input.has-focus ? 2px : 1px;
    border-radius: Theme.radius-sm;
    border-color: input.has-focus ? Theme.color-accent : Theme.color-border;
    animate border-color, border-width { duration: Theme.duration-fast; easing: ease-out; }

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        font-size: Theme.font-size-body;
        color: Theme.color-text;
        text <=> root.value;
    }

    Text {
        x: 8px;
        vertical-alignment: center;
        font-size: Theme.font-size-body;
        text: root.placeholder;
        color: Theme.color-placeholder;
        visible: root.value == "";
    }
}
