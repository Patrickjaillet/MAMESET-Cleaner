import { Theme } from "../theme.slint";

export struct NavEntry {
    label: string,
    icon: string,
}

export component Sidebar inherits Rectangle {
    in property <[NavEntry]> entries;
    in-out property <int> selected-index: 0;
    callback selected(int);

    width: 220px;
    background: transparent;

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;
        alignment: start;

        for entry[index] in entries: Rectangle {
            height: 44px;
            border-radius: Theme.radius-md;
            background: index == selected-index
                ? Theme.color-accent-soft
                : (touch.has-hover ? Theme.color-hover-tint : transparent);

            touch := TouchArea {
                clicked => {
                    selected-index = index;
                    selected(index);
                }
            }

            HorizontalLayout {
                padding-left: Theme.space-md;
                spacing: 10px;
                alignment: start;

                Text {
                    text: entry.icon;
                    vertical-alignment: center;
                }

                Text {
                    text: entry.label;
                    font-size: Theme.font-size-body;
                    color: Theme.color-text;
                    vertical-alignment: center;
                    font-weight: index == selected-index ? 600 : 400;
                }
            }
        }
    }
}
