import { Theme } from "../theme.slint";

export struct NavEntry {
    label: string,
    icon: string,
    group-start: bool,
}

// Flat classic toolbar (ROADMAP7 v6.3.0): square-cornered rows, a thin
// divider between groups, and a solid pressed-in outline for the active
// view instead of the previous sliding accent-pill indicator. Same
// existing theme colors throughout — no new palette.
export component Sidebar inherits Rectangle {
    in property <[NavEntry]> entries;
    in-out property <int> selected-index: 0;
    callback selected(int);

    width: 170px;
    background: Theme.color-surface-alt;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.color-border;
    }

    VerticalLayout {
        alignment: start;

        for entry[index] in entries: VerticalLayout {
            if entry.group-start: Rectangle {
                height: 1px;
                background: Theme.color-border-subtle;
            }

            Rectangle {
                height: 32px;
                background: index == selected-index
                    ? Theme.color-accent-soft
                    : (touch.has-hover ? Theme.color-hover-tint : transparent);
                border-width: index == selected-index ? 1px : 0px;
                border-color: Theme.color-accent;

                touch := TouchArea {
                    clicked => {
                        selected-index = index;
                        selected(index);
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    spacing: Theme.space-xs;
                    alignment: start;

                    Text {
                        text: entry.icon;
                        vertical-alignment: center;
                        font-size: Theme.font-size-body;
                    }

                    Text {
                        text: entry.label;
                        font-size: Theme.font-size-caption;
                        color: Theme.color-text;
                        vertical-alignment: center;
                        font-weight: index == selected-index ? 700 : 400;
                    }
                }
            }
        }
    }
}
