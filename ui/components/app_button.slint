import { Theme } from "../theme.slint";

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-md;
    border-width: primary ? 0px : 1px;
    border-color: Theme.color-border;
    background: !enabled
        ? Theme.color-disabled
        : (touch.pressed
            ? (primary ? Theme.color-accent-pressed : Theme.color-border-subtle)
            : (touch.has-hover
                ? (primary ? Theme.color-accent-hover : Theme.color-surface-alt)
                : (primary ? Theme.color-accent : Theme.color-surface-alt)));
    animate background { duration: Theme.duration-fast; easing: ease-out; }

    drop-shadow-color: root.primary && root.enabled ? Theme.shadow-color : transparent;
    drop-shadow-blur: touch.pressed ? 2px : (touch.has-hover ? 8px : 4px);
    drop-shadow-offset-y: touch.pressed ? 1px : 2px;
    animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.duration-fast; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-size: Theme.font-size-body;
        color: root.primary ? Theme.color-text-on-accent : Theme.color-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
