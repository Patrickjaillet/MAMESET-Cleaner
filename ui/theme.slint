export global Theme {
    // Surfaces
    out property <color> color-bg: #f3f3f3;
    out property <color> color-surface: #ffffff;
    out property <color> color-surface-alt: #f6f6f6;

    // Borders
    out property <color> color-border: #d0d0d0;
    out property <color> color-border-subtle: #e0e0e0;
    out property <color> color-border-strong: #888888;

    // Text
    out property <color> color-text: #202020;
    out property <color> color-text-secondary: #5f5f5f;
    out property <color> color-text-on-accent: #ffffff;
    out property <color> color-placeholder: #999999;

    // Accent
    out property <color> color-accent: #0078d4;
    out property <color> color-accent-hover: #106ebe;
    out property <color> color-accent-pressed: #005a9e;
    out property <color> color-accent-soft: rgba(0, 120, 212, 0.15);

    // States
    out property <color> color-disabled: #cfcfcf;
    out property <color> color-hover-tint: rgba(128, 128, 128, 0.08);

    // Spacing
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 20px;
    out property <length> space-xl: 32px;

    // Radius
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;

    // Typography
    out property <length> font-size-title: 20px;
    out property <length> font-size-heading: 15px;
    out property <length> font-size-body: 14px;
    out property <length> font-size-caption: 12px;

    // Motion
    out property <duration> duration-fast: 120ms;
    out property <duration> duration-medium: 200ms;

    // Elevation (drop shadows)
    out property <color> shadow-color: rgba(0, 0, 0, 0.12);
    out property <color> shadow-color-strong: rgba(0, 0, 0, 0.22);

    // Modal backdrop
    out property <color> scrim-color: rgba(0, 0, 0, 0.45);
}
